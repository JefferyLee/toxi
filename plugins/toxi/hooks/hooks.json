{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PLUGIN_ROOT:-./plugins/toxi}/hooks/session_start_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEX_PLUGIN_ROOT:-./plugins/toxi}/hooks/peer_check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_PLUGIN_ROOT:-./plugins/toxi}/hooks/stop_hook.py\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-./plugins/toxi}}/hooks/session_start_hook.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-./plugins/toxi}}/hooks/peer_check.sh\"; [ -f \"$f\" ] || exit 0; exec sh \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-./plugins/toxi}}/hooks/stop_hook.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
